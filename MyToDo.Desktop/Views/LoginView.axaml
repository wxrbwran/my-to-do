<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyToDo.Desktop.ViewModels"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MyToDo.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <Grid>
        <suki:GlassCard HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="400" Padding="36,32" CornerRadius="16">
            <StackPanel Spacing="18">
                <!-- 顶部 Logo 与标题 -->
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SukiPrimaryColor}" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyToDo 任务管理" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="SukiUI 高质感跨平台桌面端" FontSize="12" Foreground="{DynamicResource SukiLowText}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 错误提示 -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="13" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" HorizontalAlignment="Center"/>

                <!-- 账号输入 -->
                <TextBox Text="{Binding Account}" Watermark="请输入账号" Height="44">
                    <TextBox.InnerLeftContent>
                        <materialIcons:MaterialIcon Kind="Account" Width="18" Height="18" Margin="10,0" Foreground="{DynamicResource SukiLowText}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- 用户名（仅注册显示） -->
                <TextBox Text="{Binding Username}" Watermark="请输入昵称" Height="44"
                         IsVisible="{Binding IsRegisterMode}">
                    <TextBox.InnerLeftContent>
                        <materialIcons:MaterialIcon Kind="AccountBadge" Width="18" Height="18" Margin="10,0" Foreground="{DynamicResource SukiLowText}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- 密码输入 -->
                <TextBox Text="{Binding Password}" Watermark="请输入密码" PasswordChar="●" Height="44">
                    <TextBox.InnerLeftContent>
                        <materialIcons:MaterialIcon Kind="Lock" Width="18" Height="18" Margin="10,0" Foreground="{DynamicResource SukiLowText}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- 确认密码（仅注册显示） -->
                <TextBox Text="{Binding ConfirmPassword}" Watermark="请确认密码" PasswordChar="●" Height="44"
                         IsVisible="{Binding IsRegisterMode}">
                    <TextBox.InnerLeftContent>
                        <materialIcons:MaterialIcon Kind="LockCheck" Width="18" Height="18" Margin="10,0" Foreground="{DynamicResource SukiLowText}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- 提交按钮 -->
                <Button Command="{Binding SubmitCommand}" Height="44" Classes="Flat"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="Login" Width="18" Height="18"/>
                        <TextBlock Text="立即登录" FontWeight="SemiBold" FontSize="15"
                                   IsVisible="{Binding !IsRegisterMode}"/>
                        <TextBlock Text="完成注册" FontWeight="SemiBold" FontSize="15"
                                   IsVisible="{Binding IsRegisterMode}"/>
                    </StackPanel>
                </Button>

                <!-- 切换登录/注册 -->
                <Button Command="{Binding ToggleModeCommand}" Classes="Basic" HorizontalAlignment="Center">
                    <Panel>
                        <TextBlock Text="没有账号？立即注册" IsVisible="{Binding !IsRegisterMode}" Foreground="{DynamicResource SukiPrimaryColor}"/>
                        <TextBlock Text="已有账号？返回登录" IsVisible="{Binding IsRegisterMode}" Foreground="{DynamicResource SukiPrimaryColor}"/>
                    </Panel>
                </Button>
            </StackPanel>
        </suki:GlassCard>
    </Grid>
</UserControl>
