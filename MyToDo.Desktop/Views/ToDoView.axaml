<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyToDo.Desktop.ViewModels"
             xmlns:dtos="using:MyToDo.Shared.Dtos"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MyToDo.Desktop.Views.ToDoView"
             x:DataType="vm:ToDoViewModel">
    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- 顶部操作栏 -->
        <suki:GlassCard Grid.Row="0" Margin="0,0,0,16" Padding="14,12" CornerRadius="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- 搜索框 -->
                <TextBox Grid.Column="0" Text="{Binding SearchKey}" Watermark="搜索待办事项..." Height="42" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <!-- SukiUI 下拉状态选择框 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                    <materialIcons:MaterialIcon Kind="FilterOutline" Width="18" Height="18" Foreground="{DynamicResource SukiLowText}" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding SelectedFilterIndex}" Height="42" Width="110" VerticalAlignment="Center">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="待办中"/>
                        <ComboBoxItem Content="已完成"/>
                    </ComboBox>
                </StackPanel>

                <!-- 查询按钮 -->
                <Button Grid.Column="2" Command="{Binding SearchCommand}" Height="42" Classes="Basic" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18"/>
                        <TextBlock Text="查询" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 新建待办按钮 -->
                <Button Grid.Column="3" Command="{Binding AddToDoCommand}" Height="42" Classes="Flat" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        <TextBlock Text="新建待办" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </suki:GlassCard>

        <!-- 待办列表 -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding TodoList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ToDoDto">
                        <suki:GlassCard Margin="0,0,0,10" Padding="16,14" CornerRadius="10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- 完成状态复选按钮 -->
                                <Button Grid.Column="0" Classes="Basic" Padding="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Command="{Binding ((vm:ToDoViewModel)DataContext).ToggleToDoStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="22" Height="22" Foreground="{DynamicResource SukiPrimaryColor}"/>
                                </Button>

                                <!-- 标题与内容 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 编辑 -->
                                <Button Grid.Column="2" Classes="Basic" Padding="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Command="{Binding ((vm:ToDoViewModel)DataContext).EditToDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="18" Height="18" Foreground="{DynamicResource SukiPrimaryColor}"/>
                                </Button>

                                <!-- 删除 -->
                                <Button Grid.Column="3" Classes="Basic" Padding="6" VerticalAlignment="Center"
                                        Command="{Binding ((vm:ToDoViewModel)DataContext).DeleteToDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="Red"/>
                                </Button>
                            </Grid>
                        </suki:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
