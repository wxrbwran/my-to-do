<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyToDo.Desktop.ViewModels"
             xmlns:dtos="using:MyToDo.Shared.Dtos"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:mControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MyToDo.Desktop.Views.ToDoView"
             x:DataType="vm:ToDoViewModel">
    <UserControl.Styles>
        <!-- 去除筛选 ComboBox 默认的突兀下划线与红线，使其与搜索框完全融合 -->
        <Style Selector="ComboBox.filter mControls|MaterialUnderline">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ComboBox.filter">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20">
        <!-- 顶部操作栏 -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="14,10" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="10" BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- 搜索框 -->
                <TextBox Grid.Column="0" Text="{Binding SearchKey}" Watermark="搜索待办事项..." Classes="outline" Height="42" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <!-- 精美状态选择框容器 -->
                <Border Grid.Column="1" Height="42" Margin="0,0,12,0" Padding="10,0" 
                        Background="{DynamicResource MaterialDesignPaper}" 
                        BorderBrush="{DynamicResource MaterialDesignDivider}" 
                        BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">
                            <materialIcons:MaterialIcon Kind="FilterOutline" Width="16" Height="16" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="状态:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Classes="filter" SelectedIndex="{Binding SelectedFilterIndex}" 
                                  VerticalAlignment="Center" Width="95">
                            <ComboBoxItem Content="全部"/>
                            <ComboBoxItem Content="待办中"/>
                            <ComboBoxItem Content="已完成"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 查询按钮 -->
                <Button Grid.Column="2" Command="{Binding SearchCommand}" Height="42" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,12,0" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18"/>
                        <TextBlock Text="查询" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 新建待办按钮 -->
                <Button Grid.Column="3" Command="{Binding AddToDoCommand}" Height="42" CornerRadius="6" VerticalAlignment="Center" Background="{DynamicResource SecondaryHueMidBrush}" Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        <TextBlock Text="新建待办" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 待办列表 -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding TodoList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ToDoDto">
                        <Border Margin="0,0,0,10" Padding="16" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="10" BoxShadow="0 2 6 0 #15000000">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- 完成状态复选按钮 -->
                                <Button Grid.Column="0" Classes="flat" Padding="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Command="{Binding ((vm:ToDoViewModel)DataContext).ToggleToDoStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </Button>

                                <!-- 标题与内容 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 编辑 -->
                                <Button Grid.Column="2" Classes="flat" Padding="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Command="{Binding ((vm:ToDoViewModel)DataContext).EditToDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="SquareEditOutline" Width="20" Height="20" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </Button>

                                <!-- 删除 -->
                                <Button Grid.Column="3" Classes="flat" Padding="8" VerticalAlignment="Center"
                                        Command="{Binding ((vm:ToDoViewModel)DataContext).DeleteToDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="20" Height="20" Foreground="Red"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
