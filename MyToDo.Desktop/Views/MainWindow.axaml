<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:vm="using:MyToDo.Desktop.ViewModels"
                 xmlns:models="using:MyToDo.Desktop.Models"
                 xmlns:views="using:MyToDo.Desktop.Views"
                 x:Class="MyToDo.Desktop.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Title="MyToDo - 跨平台任务管理"
                 Width="1140" Height="740"
                 MinWidth="850" MinHeight="580"
                 WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:IndexViewModel}">
            <views:IndexView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToDoViewModel}">
            <views:ToDoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoViewModel}">
            <views:MemoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkinViewModel}">
            <views:SkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
    </Window.DataTemplates>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DialogCardBackground" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DialogCardBackground" Color="#1E232E"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 主布局：侧边栏 + 工作区 -->
        <Grid ColumnDefinitions="250,*">
            <!-- 左侧侧边栏导航 -->
            <Border Grid.Column="0" Background="{DynamicResource SukiGlassCardBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 顶部 Logo 标识 -->
                    <StackPanel Grid.Row="0" Margin="20,24,20,20" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <suki:GlassCard Width="40" Height="40" CornerRadius="10" Padding="0">
                                <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="24" Height="24" Foreground="{DynamicResource SukiPrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </suki:GlassCard>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="MyToDo" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="SukiUI 跨平台效率版" FontSize="11" Foreground="{DynamicResource SukiLowText}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 菜单导航项列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding MenuBars}" SelectedItem="{Binding SelectedMenu}"
                             Background="Transparent" Margin="10,0" Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Foreground" Value="{DynamicResource SukiText}"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Foreground" Value="{DynamicResource SukiPrimaryColor}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MenuBar">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="20" Height="20" 
                                                                Foreground="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                               Foreground="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部用户信息与注销 -->
                    <suki:GlassCard Grid.Row="2" Margin="12,16" Padding="12" CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SukiPrimaryColor}" Margin="0,0,10,0">
                                <materialIcons:MaterialIcon Kind="Account" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="SukiUI 活跃" FontSize="10" Foreground="Green"/>
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding LogoutCommand}" Classes="Basic" Padding="4" ToolTip.Tip="注销账号">
                                <materialIcons:MaterialIcon Kind="Logout" Width="18" Height="18" Foreground="{DynamicResource SukiLowText}"/>
                            </Button>
                        </Grid>
                    </suki:GlassCard>
                </Grid>
            </Border>

            <!-- 右侧主页面容器 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- 全局弹窗模态层（添加/编辑待办与备忘录） -->
        <Border Background="#A0000000" IsVisible="{Binding IsDialogOpen}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Padding="28,24" CornerRadius="16"
                    Background="{DynamicResource DialogCardBackground}"
                    BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 24 64 0 #90000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 弹窗标题与关闭按钮 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SukiText}"/>
                        <Button Grid.Column="1" Command="{Binding CloseDialogCommand}" Classes="Basic" Padding="4">
                            <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource SukiLowText}"/>
                        </Button>
                    </Grid>

                    <!-- 表单内容 -->
                    <StackPanel Grid.Row="1" Spacing="16" IsVisible="{Binding DialogContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding DialogContent}">
                            <ContentControl.DataTemplates>
                                <!-- 待办编辑模板 -->
                                <DataTemplate DataType="{x:Type vm:AddToDoDialogViewModel}">
                                    <StackPanel Spacing="16">
                                        <TextBox Text="{Binding Title}" Watermark="请输入待办标题..." Height="44"/>
                                        <TextBox Text="{Binding Content}" Watermark="请输入详细内容描述..." AcceptsReturn="True" Height="110"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                                            <Button Command="{Binding CancelCommand}" Classes="Basic" Content="取消" Height="38" Padding="18,0"/>
                                            <Button Command="{Binding SaveCommand}" Classes="Flat" Content="保存" Height="38" Padding="22,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 备忘编辑模板 -->
                                <DataTemplate DataType="{x:Type vm:AddMemoDialogViewModel}">
                                    <StackPanel Spacing="16">
                                        <TextBox Text="{Binding Title}" Watermark="请输入便签标题..." Height="44"/>
                                        <TextBox Text="{Binding Content}" Watermark="请输入便签详细内容..." AcceptsReturn="True" Height="130"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                                            <Button Command="{Binding CancelCommand}" Classes="Basic" Content="取消" Height="38" Padding="18,0"/>
                                            <Button Command="{Binding SaveCommand}" Classes="Flat" Content="保存" Height="38" Padding="22,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</suki:SukiWindow>
