<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyToDo.Desktop.ViewModels"
        xmlns:models="using:MyToDo.Desktop.Models"
        xmlns:views="using:MyToDo.Desktop.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MyToDo.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MyToDo - 跨平台任务管理"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:IndexViewModel}">
            <views:IndexView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToDoViewModel}">
            <views:ToDoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoViewModel}">
            <views:MemoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkinViewModel}">
            <views:SkinView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <!-- 主布局：当处于登录状态时显示左右分割；未登录时直接显示登录页面 -->
        <Grid ColumnDefinitions="240,*">
            <!-- 左侧侧边栏导航 -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 顶部 Logo 标识 -->
                    <StackPanel Grid.Row="0" Margin="20,24,20,20" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource PrimaryHueMidBrush}">
                                <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="MyToDo" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBlock Text="跨平台效率应用" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 菜单导航项列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding MenuBars}" SelectedItem="{Binding SelectedMenu}"
                             Background="Transparent" Margin="8,0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MenuBar">
                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="10,6">
                                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部用户信息与注销 -->
                    <Border Grid.Row="2" Margin="12,16" Padding="12" CornerRadius="8" Background="{DynamicResource MaterialDesignPaper}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0">
                                <materialIcons:MaterialIcon Kind="Account" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="已连接" FontSize="10" Foreground="Green"/>
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding LogoutCommand}" Classes="flat" Padding="4" ToolTip.Tip="注销账号">
                                <materialIcons:MaterialIcon Kind="Logout" Width="18" Height="18" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧主页面容器 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- 全局弹窗模态层（添加/编辑待办与备忘录） -->
        <Border Background="#60000000" IsVisible="{Binding IsDialogOpen}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Padding="24" CornerRadius="12"
                    Background="{DynamicResource MaterialDesignCardBackground}" BoxShadow="0 10 30 0 #40000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 弹窗标题 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold"/>
                        <Button Grid.Column="1" Command="{Binding CloseDialogCommand}" Classes="flat" Padding="2">
                            <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- 待办事项表单 -->
                    <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding DialogContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding DialogContent}">
                            <ContentControl.DataTemplates>
                                <!-- 待办编辑模板 -->
                                <DataTemplate DataType="{x:Type vm:AddToDoDialogViewModel}">
                                    <StackPanel Spacing="14">
                                        <TextBox Text="{Binding Title}" Watermark="请输入标题..." Classes="outline" UseFloatingWatermark="True"/>
                                        <TextBox Text="{Binding Content}" Watermark="请输入详细内容..." AcceptsReturn="True" Height="100" Classes="outline" UseFloatingWatermark="True"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                            <Button Command="{Binding CancelCommand}" Classes="flat" Content="取消"/>
                                            <Button Command="{Binding SaveCommand}" Background="{DynamicResource PrimaryHueMidBrush}" Foreground="White" Content="保存"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 备忘编辑模板 -->
                                <DataTemplate DataType="{x:Type vm:AddMemoDialogViewModel}">
                                    <StackPanel Spacing="14">
                                        <TextBox Text="{Binding Title}" Watermark="请输入便签标题..." Classes="outline" UseFloatingWatermark="True"/>
                                        <TextBox Text="{Binding Content}" Watermark="请输入便签内容..." AcceptsReturn="True" Height="120" Classes="outline" UseFloatingWatermark="True"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                                            <Button Command="{Binding CancelCommand}" Classes="flat" Content="取消"/>
                                            <Button Command="{Binding SaveCommand}" Background="{DynamicResource SecondaryHueMidBrush}" Foreground="White" Content="保存"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
