<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyToDo.Desktop.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MyToDo.Desktop.Views.SkinView"
             x:DataType="vm:SkinViewModel">
    <ScrollViewer Margin="20">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <!-- 主题模式设置 -->
            <Border Padding="20" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" BoxShadow="0 4 12 0 #15000000">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="深浅外观模式" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="切换系统的显示模式，适配夜间或明亮光线环境。" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="深色暗黑主题" FontSize="15" FontWeight="Medium"/>
                            <TextBlock Text="降低眼睛疲劳，提升沉浸体验" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 主色调调色盘 -->
            <Border Padding="20" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" BoxShadow="0 4 12 0 #15000000">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <materialIcons:MaterialIcon Kind="Palette" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="系统主调色板" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="选择你喜爱的主题高亮主色调，界面各组件将实时响应。" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                    <ItemsControl ItemsSource="{Binding ColorOptions}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColorOption">
                                <Button Classes="flat" Margin="6" Padding="6" CornerRadius="10"
                                        Command="{Binding ((vm:SkinViewModel)DataContext).ChangePrimaryColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Width="110" Height="80" CornerRadius="8" Background="{Binding HexColor}" BoxShadow="0 4 10 0 #25000000">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
