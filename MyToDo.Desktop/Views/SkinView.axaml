<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyToDo.Desktop.ViewModels"
             xmlns:models="clr-namespace:SukiUI.Models;assembly=SukiUI"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MyToDo.Desktop.Views.SkinView"
             x:DataType="vm:SkinViewModel">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <!-- 外观与主题模式 -->
            <suki:GlassCard Padding="24" CornerRadius="14">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="24" Height="24" Foreground="{DynamicResource SukiPrimaryColor}"/>
                        <TextBlock Text="外观显示与主题模式" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="切换明亮模式或沉浸暗黑模式，带来舒适的视觉体验。" FontSize="13" Foreground="{DynamicResource SukiLowText}"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="深色暗黑主题" FontSize="15" FontWeight="Medium"/>
                            <TextBlock Text="夜晚或弱光环境下保护视力" FontSize="12" Foreground="{DynamicResource SukiLowText}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}"/>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>

            <!-- SukiUI 主题调色板 -->
            <suki:GlassCard Padding="24" CornerRadius="14">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <materialIcons:MaterialIcon Kind="Palette" Width="24" Height="24" Foreground="{DynamicResource SukiPrimaryColor}"/>
                        <TextBlock Text="主题个性化色彩" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="选择 SukiUI 精心调配的主题色，全应用控件与光影将实时渐变跟随。" FontSize="13" Foreground="{DynamicResource SukiLowText}"/>

                    <ItemsControl ItemsSource="{Binding ColorThemes}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SukiColorTheme">
                                <Button Classes="Basic" Margin="6" Padding="4" CornerRadius="10"
                                        Command="{Binding ((vm:SkinViewModel)DataContext).ChangeColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <suki:GlassCard Width="110" Height="70" CornerRadius="10" Padding="0">
                                        <Grid>
                                            <Border CornerRadius="8" Margin="4" Background="{Binding PrimaryBrush}" Opacity="0.9"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </suki:GlassCard>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </suki:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
